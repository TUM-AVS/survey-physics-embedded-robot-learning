@incollection{MILLER199717_dynamic_walk,
title = {2 - Dynamic Balance of a Biped Walking Robot: Adaptive Gait Modulation Using CMAC Neural Networks},
editor = {Omid Omidvar and Patrick {van der Smagt}},
booktitle = {Neural Systems for Robotics},
publisher = {Academic Press},
address = {Boston},
pages = {17-35},
year = {1997},
isbn = {978-0-08-092509-7},
doi = {https://doi.org/10.1016/B978-0-08-092509-7.50006-3},
author = {W. Thomas Miller and Andrew L. Kun},
abstract = {ABSTRACT
This chapter presents an example of the application of online neural network learning to the problem of biped walking with dynamic balance. The experimental biped robot had 10 actuators, 10 joint position sensors, 8 foot force sensors, and 2 body accelerometers. The control architecture was centered around a gait oscillator which generated basic walking motions phase-locked via sensory triggers to the natural dynamics of the biped. These primitive walking patterns were then modulated by neural network learning. Separate CMAC neural networks were responsible for the adaptive control of side-to-side and front-to-back balance, as well as for maintaining good foot contact. Qualitative and quantitative test results showed that biped performance improved with neural network training. Following approximately one hour of training, the biped was able to start and stop on demand, and to walk with continuous motion on flat surfaces at a rate of up to 100 steps per minute, with up to 6-cm step lengths.},
  survey_family      = {background},
  survey_kind        = {background},
}

